  <bpmn2:process id="flux_formular_petitii" drools:packageName="ro.gov.oli.petitii" drools:version="1.0" drools:adHoc="false" name="Flux Formular Petiții" isExecutable="true" processType="Public">
    <bpmn2:documentation><![CDATA[Variabile de decizie:
 departament     = DGAL | SRUE | SAITC | SJCREP | ALTE   (repartizare / transfer / redistribuire)
 decizieDGAL     = DAL | SRMRI | PCUEL | NICIUNA
 decizieDirectie = RASPUNS | TRANSFER | OPINIE
 solicitant      = direcția care cere opinii; opinieDGAL/opinieSRUE/opinieSAITC/opinieSJCREP = true/false
 decizieCabinet  = CONDUCERE | REDISTRIBUIRE]]></bpmn2:documentation>
    <bpmn2:extensionElements><drools:import name="java.lang.String"/></bpmn2:extensionElements>
    <bpmn2:property id="departament" itemSubjectRef="_departamentItem" name="departament"/>
    <bpmn2:property id="decizieDGAL" itemSubjectRef="_decizieDGALItem" name="decizieDGAL"/>
    <bpmn2:property id="decizieSubdirectie" itemSubjectRef="_decizieSubdirectieItem" name="decizieSubdirectie"/>
    <bpmn2:property id="decizieDirectie" itemSubjectRef="_decizieDirectieItem" name="decizieDirectie"/>
    <bpmn2:property id="decizieCabinet" itemSubjectRef="_decizieCabinetItem" name="decizieCabinet"/>
    <bpmn2:property id="decizieSemnare" itemSubjectRef="_decizieSemnareItem" name="decizieSemnare"/>
    <bpmn2:property id="solicitant" itemSubjectRef="_solicitantItem" name="solicitant"/>
    <bpmn2:property id="opinieDGAL" itemSubjectRef="_opinieDGALItem" name="opinieDGAL"/>
    <bpmn2:property id="opinieSRUE" itemSubjectRef="_opinieSRUEItem" name="opinieSRUE"/>
    <bpmn2:property id="opinieSAITC" itemSubjectRef="_opinieSAITCItem" name="opinieSAITC"/>
    <bpmn2:property id="opinieSJCREP" itemSubjectRef="_opinieSJCREPItem" name="opinieSJCREP"/>
    <bpmn2:startEvent id="StartEvent_1" name="Petiție primită">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Petiție primită]]></drools:metaValue></drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>Flow_01</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Task_Inregistrare" name="Înregistrare petiție (PCUEL / Site OLI)">
      <bpmn2:documentation><![CDATA[departament: DGAL | SRUE | SAITC | SJCREP | ALTE]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Înregistrare petiție (PCUEL / Site OLI)]]></drools:metaValue></drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_01</bpmn2:incoming>
      <bpmn2:outgoing>Flow_02</bpmn2:outgoing>
      <bpmn2:ioSpecification id="Task_Inregistrare_io">
        <bpmn2:dataInput id="Task_Inregistrare_TaskNameInputX" drools:dtype="Object" itemSubjectRef="_Task_Inregistrare_TaskNameInputXItem" name="TaskName"/>
        <bpmn2:dataInput id="Task_Inregistrare_GroupIdInputX" drools:dtype="Object" itemSubjectRef="_Task_Inregistrare_GroupIdInputXItem" name="GroupId"/>
        <bpmn2:dataInput id="Task_Inregistrare_SkippableInputX" drools:dtype="Object" itemSubjectRef="_Task_Inregistrare_SkippableInputXItem" name="Skippable"/>
        <bpmn2:dataOutput id="Task_Inregistrare_departamentOutputX" drools:dtype="String" itemSubjectRef="_Task_Inregistrare_departamentOutputXItem" name="departament"/>
        <bpmn2:inputSet id="Task_Inregistrare_InputSet">
          <bpmn2:dataInputRefs>Task_Inregistrare_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_Inregistrare_GroupIdInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_Inregistrare_SkippableInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="Task_Inregistrare_OutputSet">
          <bpmn2:dataOutputRefs>Task_Inregistrare_departamentOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="Task_Inregistrare_dia1">
        <bpmn2:targetRef>Task_Inregistrare_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment id="Task_Inregistrare_as1"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="Task_Inregistrare_fr1"><![CDATA[Inregistrare]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="Task_Inregistrare_to1"><![CDATA[Task_Inregistrare_TaskNameInputX]]></bpmn2:to></bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="Task_Inregistrare_dia2">
        <bpmn2:targetRef>Task_Inregistrare_GroupIdInputX</bpmn2:targetRef>
        <bpmn2:assignment id="Task_Inregistrare_as2"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="Task_Inregistrare_fr2"><![CDATA[registratura]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="Task_Inregistrare_to2"><![CDATA[Task_Inregistrare_GroupIdInputX]]></bpmn2:to></bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="Task_Inregistrare_dia3">
        <bpmn2:targetRef>Task_Inregistrare_SkippableInputX</bpmn2:targetRef>
        <bpmn2:assignment id="Task_Inregistrare_as3"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="Task_Inregistrare_fr3"><![CDATA[false]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="Task_Inregistrare_to3"><![CDATA[Task_Inregistrare_SkippableInputX]]></bpmn2:to></bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="Task_Inregistrare_doa1">
        <bpmn2:sourceRef>Task_Inregistrare_departamentOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>departament</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gw_Repart_Join" name="" gatewayDirection="Converging">
      <bpmn2:incoming>Flow_02</bpmn2:incoming>
      <bpmn2:incoming>Flow_Dir_Transfer</bpmn2:incoming>
      <bpmn2:incoming>Flow_OpB2</bpmn2:incoming>
      <bpmn2:incoming>Flow_C_Redist</bpmn2:incoming>
      <bpmn2:incoming>Flow_Sem_Ret</bpmn2:incoming>
      <bpmn2:outgoing>Flow_03</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gw_Repart" name="Repartizare pe direcții" gatewayDirection="Diverging" default="Flow_R_Alte">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Repartizare pe direcții]]></drools:metaValue></drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_03</bpmn2:incoming>
      <bpmn2:outgoing>Flow_R_DGAL</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_R_SRUE</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_R_SAITC</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_R_SJCREP</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_R_Alte</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gw_DGAL_In" name="" gatewayDirection="Converging">
      <bpmn2:incoming>Flow_R_DGAL</bpmn2:incoming>
      <bpmn2:incoming>Flow_S_Inapoi</bpmn2:incoming>
      <bpmn2:outgoing>Flow_DGAL_In</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Task_DGAL" name="Soluționare DGAL">
      <bpmn2:documentation><![CDATA[decizieDGAL: DAL | SRMRI | PCUEL | SEMNARE | NICIUNA; decizieDirectie: RASPUNS | TRANSFER | OPINIE; departament: direcția țintă la TRANSFER; decizieDirectie=OPINIE: solicitant = direcția curentă, opinieDGAL/opinieSRUE/opinieSAITC/opinieSJCREP = true pentru direcțiile de la care se cere opinie]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Soluționare DGAL]]></drools:metaValue></drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_DGAL_In</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>
      <bpmn2:ioSpecification id="Task_DGAL_io">
        <bpmn2:dataInput id="Task_DGAL_TaskNameInputX" drools:dtype="Object" itemSubjectRef="_Task_DGAL_TaskNameInputXItem" name="TaskName"/>
        <bpmn2:dataInput id="Task_DGAL_GroupIdInputX" drools:dtype="Object" itemSubjectRef="_Task_DGAL_GroupIdInputXItem" name="GroupId"/>
        <bpmn2:dataInput id="Task_DGAL_SkippableInputX" drools:dtype="Object" itemSubjectRef="_Task_DGAL_SkippableInputXItem" name="Skippable"/>
        <bpmn2:dataOutput id="Task_DGAL_decizieDGALOutputX" drools:dtype="String" itemSubjectRef="_Task_DGAL_decizieDGALOutputXItem" name="decizieDGAL"/>
        <bpmn2:dataOutput id="Task_DGAL_decizieDirectieOutputX" drools:dtype="String" itemSubjectRef="_Task_DGAL_decizieDirectieOutputXItem" name="decizieDirectie"/>
        <bpmn2:dataOutput id="Task_DGAL_departamentOutputX" drools:dtype="String" itemSubjectRef="_Task_DGAL_departamentOutputXItem" name="departament"/>
        <bpmn2:dataOutput id="Task_DGAL_solicitantOutputX" drools:dtype="String" itemSubjectRef="_Task_DGAL_solicitantOutputXItem" name="solicitant"/>
        <bpmn2:dataOutput id="Task_DGAL_opinieDGALOutputX" drools:dtype="Boolean" itemSubjectRef="_Task_DGAL_opinieDGALOutputXItem" name="opinieDGAL"/>
        <bpmn2:dataOutput id="Task_DGAL_opinieSRUEOutputX" drools:dtype="Boolean" itemSubjectRef="_Task_DGAL_opinieSRUEOutputXItem" name="opinieSRUE"/>
        <bpmn2:dataOutput id="Task_DGAL_opinieSAITCOutputX" drools:dtype="Boolean" itemSubjectRef="_Task_DGAL_opinieSAITCOutputXItem" name="opinieSAITC"/>
        <bpmn2:dataOutput id="Task_DGAL_opinieSJCREPOutputX" drools:dtype="Boolean" itemSubjectRef="_Task_DGAL_opinieSJCREPOutputXItem" name="opinieSJCREP"/>
        <bpmn2:inputSet id="Task_DGAL_InputSet">
          <bpmn2:dataInputRefs>Task_DGAL_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_DGAL_GroupIdInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_DGAL_SkippableInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="Task_DGAL_OutputSet">
          <bpmn2:dataOutputRefs>Task_DGAL_decizieDGALOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_DGAL_decizieDirectieOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_DGAL_departamentOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_DGAL_solicitantOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_DGAL_opinieDGALOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_DGAL_opinieSRUEOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_DGAL_opinieSAITCOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_DGAL_opinieSJCREPOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="Task_DGAL_dia1">
        <bpmn2:targetRef>Task_DGAL_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment id="Task_DGAL_as1"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="Task_DGAL_fr1"><![CDATA[DGAL]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="Task_DGAL_to1"><![CDATA[Task_DGAL_TaskNameInputX]]></bpmn2:to></bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="Task_DGAL_dia2">
        <bpmn2:targetRef>Task_DGAL_GroupIdInputX</bpmn2:targetRef>
        <bpmn2:assignment id="Task_DGAL_as2"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="Task_DGAL_fr2"><![CDATA[dgal]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="Task_DGAL_to2"><![CDATA[Task_DGAL_GroupIdInputX]]></bpmn2:to></bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="Task_DGAL_dia3">
        <bpmn2:targetRef>Task_DGAL_SkippableInputX</bpmn2:targetRef>
